# Copy to secrets.toml in Cloud Shell, fill in, then store it in Secret Manager (see docs/DEPLOY.md).
# Never commit the filled-in file.
[auth]
redirect_uri = "https://foundation-studio-237377681531.us-central1.run.app/oauth2callback"
cookie_secret = "PASTE-OUTPUT-OF: python3 -c 'import secrets; print(secrets.token_hex(32))'"
client_id = "PASTE-CLIENT-ID.apps.googleusercontent.com"
client_secret = "PASTE-CLIENT-SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
